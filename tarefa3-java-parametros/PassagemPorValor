public class PassagemPorValor {

    public static void main(String[] args) {
        int numero = 10; 

        System.out.println("--- No Main (Antes da chamada) ---");
        System.out.println("Valor de 'numero': " + numero);

        alterarNumero(numero);

        System.out.println("\n--- No Main (Depois da chamada) ---");
        System.out.println("Valor de 'numero' no main continua: " + numero);
    }

    public static void alterarNumero(int x) {
        System.out.println("\n--- Dentro do método alterarNumero ---");
        System.out.println("Valor de x recebido: " + x);

        x = x + 50; 

        System.out.println("Valor de x após alteração local: " + x);
    }
}
