import java.util.Locale;
import java.util.Scanner;

public class SistemaAcademicoModular {
    // Scanner global para que todos os métodos possam usar [cite: 67, 70]
    static Scanner sc = new Scanner(System.in).useLocale(Locale.US);

    public static void main(String[] args) {
        // O loop controla a repetição para os 5 alunos [cite: 56]
        for (int i = 1; i <= 5; i++) {
            System.out.println("\n--- Aluno " + i + " ---");
            
            String nome = lerAluno(); // Chama subprograma de leitura [cite: 70]
            double[] notas = lerNotas(); // Chama subprograma de notas [cite: 71]
            double media = calcularMedia(notas); // Passagem de parâmetro e retorno [cite: 72, 76, 77]
            String situacao = determinarSituacao(media); // Lógica de negócio [cite: 73]
            
            imprimirRelatorio(nome, media, situacao); // Saída formatada [cite: 74]
        }
    }

    public static String lerAluno() {
        System.out.print("Digite o nome: ");
        return sc.nextLine();
    }

    public static double[] lerNotas() {
        double[] n = new double[3]; // [cite: 57]
        for (int i = 0; i < 3; i++) {
            System.out.print("Nota " + (i + 1) + ": ");
            n[i] = sc.nextDouble();
        }
        sc.nextLine(); // Limpa o "Enter" do teclado
        return n;
    }

    public static double calcularMedia(double[] notas) {
        double soma = 0;
        for (double nota : notas) {
            soma += nota; // [cite: 58]
        }
        return soma / 3;
    }

    public static String determinarSituacao(double media) {
        if (media >= 7) return "Aprovado"; // [cite: 60]
        if (media >= 5) return "Recuperação"; // [cite: 61]
        return "Reprovado"; // [cite: 62]
    }

    public static void imprimirRelatorio(String nome, double media, String situacao) {
        System.out.println("-----------------------");
        System.out.printf("Aluno: %s | Média: %.2f | Status: %s\n", nome, media, situacao); // [cite: 63]
    }
}
